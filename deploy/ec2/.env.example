# Vexa Lite on EC2 — copy to .env and fill. Comments stay on their own line
# (`docker run --env-file` keeps a trailing `# ...` as part of the value).

# Public hostname Caddy gets a Let's Encrypt cert for. A-record must point here first.
VEXA_DOMAIN=vexa.example.com
ACME_EMAIL=ops@example.com

# Same Docker Hub org as the Cofounder Circle backend. Different image name so
# it does not overwrite cofoundercircle/cfc:test.
VEXA_IMAGE=cofoundercircle/vexa-lite:test

# The URL your backend calls. Must be https:// + VEXA_DOMAIN (no trailing slash).
VEXA_PUBLIC_API_URL=https://vexa.example.com

# --- STT (Groq) --------------------------------------------------------------
# Base URL only — the bot appends /v1/audio/transcriptions.
# WRONG: https://api.groq.com/openai/v1
# RIGHT: https://api.groq.com/openai
TRANSCRIPTION_SERVICE_URL=https://api.groq.com/openai
TRANSCRIPTION_SERVICE_TOKEN=
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Guest display name in Meet / Teams / Zoom.
DEFAULT_BOT_NAME=Cofounder Circle Notes

# Leave after everyone else has left (ms). 60000 = 1 minute. Product default is 10 minutes.
BOT_ALONE_SILENCE_WINDOW_MS=60000

# --- secrets (bootstrap.sh mints these if you leave them empty) --------------
ADMIN_TOKEN=
INTERNAL_API_SECRET=
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Optional: pin the API key the backend will use. Empty → Lite mints one on first boot;
# read it with:  ./print-api-key.sh
VEXA_API_KEY=

# Keep recordings (MinIO). Need ~100 GB disk; recordings filled a 80 GB volume in local test.
RECORDING_ENABLED=true
TRANSCRIBE_ENABLED=true
